<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".register.RegisterActivity">

    <!-- Splash Screen Background with Gradient -->
    <View
        android:id="@+id/backgroundGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_gradient_bg" />

    <!-- Particle Background View from Splash Screen -->
    <com.example.mtc_app.splashScreen.ParticlesView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Animated Background Elements from Splash Screen -->
    <!-- Pulsating Outer Circle -->
    <View
        android:id="@+id/pulseCircle1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/circle_outline"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="80dp"
        android:alpha="0.3" />

    <!-- Interactive Progress Ring -->
    <com.mikhaellopez.circularprogressbar.CircularProgressBar
        android:id="@+id/backgroundProgressBar"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:cpb_background_progressbar_color="#ECEFF1"
        app:cpb_background_progressbar_width="2dp"
        app:cpb_progress_direction="to_right"
        app:cpb_progress_max="100"
        app:cpb_progressbar_color="#2196F3"
        app:cpb_progressbar_width="2dp"
        app:cpb_round_border="true"
        android:contentDescription="Background animation"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="70dp"
        android:alpha="0.4" />

    <!-- Additional Decorative Circles -->
    <View
        android:id="@+id/pulseCircle2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/circle_outline"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="150dp"
        android:alpha="0.2" />

    <View
        android:id="@+id/pulseCircle3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_outline"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="250dp"
        android:alpha="0.25" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/registerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="32dp"
                app:cardPreventCornerOverlap="true"
                android:translationZ="8dp"
                app:cardBackgroundColor="#FAFAFA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="40dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Create Account"
                        android:textSize="32sp"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/lavender"
                        android:layout_marginBottom="40dp"
                        android:letterSpacing="0.05"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:startIconDrawable="@drawable/ic_person"
                        app:boxStrokeColor="@color/lavender"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:hintTextColor="@color/lavender">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Full Name"
                            android:inputType="textPersonName"
                            android:textColor="@color/black"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:letterSpacing="0.03"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:startIconDrawable="@drawable/ic_email"
                        app:boxStrokeColor="@color/lavender"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:hintTextColor="@color/lavender">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email Address"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/black"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:letterSpacing="0.03"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:boxStrokeColor="@color/lavender"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:hintTextColor="@color/lavender">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Password"
                            android:inputType="textPassword"
                            android:textColor="@color/black"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:letterSpacing="0.03"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:boxStrokeColor="@color/lavender"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:hintTextColor="@color/lavender">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Phone Number"
                            android:inputType="phone"
                            android:textColor="@color/black"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:letterSpacing="0.03"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:id="@+id/registerButtonFrame"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/registerButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Create Account"
                            android:textSize="18sp"
                            android:textAllCaps="false"
                            android:backgroundTint="@color/lavender"
                            android:elevation="4dp"
                            android:fontFamily="sans-serif-medium" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_redirect_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Already have an account? Login"
                android:textColor="@color/lavender"
                android:textSize="16sp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>