<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#F5F7FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Single Unified Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Section with Gradient Background -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/header_gradient"
                        android:paddingVertical="24dp"
                        android:paddingHorizontal="24dp">

                        <TextView
                            android:id="@+id/nameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Doe"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.03"
                            android:layout_centerHorizontal="true"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/nameText"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/addressText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:alpha="0.95"
                                android:drawableStart="@drawable/ic_location"
                                android:drawablePadding="12dp"
                                android:drawableTint="@android:color/white"
                                android:fontFamily="sans-serif"
                                android:gravity="center_vertical"
                                android:text="123 Main Street"
                                android:textColor="@android:color/white"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/phoneText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:alpha="0.95"
                                android:drawableStart="@drawable/ic_phone"
                                android:drawablePadding="12dp"
                                android:drawableTint="@android:color/white"
                                android:fontFamily="sans-serif"
                                android:gravity="center_vertical"
                                android:text="9876543210"
                                android:textColor="@android:color/white"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/emailText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.95"
                                android:drawableStart="@drawable/ic_email"
                                android:drawablePadding="12dp"
                                android:drawableTint="@android:color/white"
                                android:fontFamily="sans-serif"
                                android:gravity="center_vertical"
                                android:text="john@example.com"
                                android:textColor="@android:color/white"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Order Information Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/labJobNumberText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Job ID:"
                                android:textSize="16sp"
                                android:textColor="#000000"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:id="@+id/dateText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2023-05-18"
                                android:textSize="14sp"
                                android:textColor="#666666"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end"/>
                        </LinearLayout>

                        <!-- Price Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Price:"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:id="@+id/totalPriceText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="₹2,850.00"
                                android:textSize="16sp"
                                android:textColor="@color/Lavender"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end"/>
                        </LinearLayout>

                        <!-- Radio Selections Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Order Specifications"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/radioSelectionsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Sample Condition: Sealed\n• Compliance Statement: NO\n• Standard Deviation: NO\n• Mode of Dispatch: Post\n• Condition of Sample: SEALED\n• Capability Available: YES\n• Requirements Defined: NO\n• Method of Testing: true\n• Terms &amp; Conditions Accepted: true\n• Testing Services Approved: true"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="8dp"/>

                        <!-- Selected Points Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selected Points"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/selectedPointsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Not Available"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="8dp"/>

                        <!-- Deviation Details Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Deviation Details"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/deviationDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Not Available"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="8dp"/>

                        <!-- Discussion Details Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Discussion Details"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/discussionDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="great"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="8dp"/>

                        <!-- Test Selections Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Test Selections"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/testSelectionsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aggregate Fine:\n\nCement:\n\nSoil:\n   • FREE SWELL INDEX\n   • CONSOLIDATION TEST\n   • TRIAXIAL TEST CU\n\nSteel:"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="8dp"/>

                        <!-- Review Remarks Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Review Remarks"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/reviewRemarksText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Not Available"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="8dp"/>

                        <!-- Order Status Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="20dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="#F0F4FF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="16dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Dispatch"
                                        android:textSize="14sp"
                                        android:textColor="#666666"
                                        android:fontFamily="sans-serif-medium"/>

                                    <TextView
                                        android:id="@+id/dispatchModeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Express"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/Lavender"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_marginTop="4dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                android:layout_marginStart="8dp"
                                app:cardBackgroundColor="#F0F4FF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="16dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sample"
                                        android:textSize="14sp"
                                        android:textColor="#666666"
                                        android:fontFamily="sans-serif-medium"/>

                                    <TextView
                                        android:id="@+id/sampleText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="great"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/Lavender"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_marginTop="4dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

</FrameLayout>