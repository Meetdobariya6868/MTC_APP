<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FF"
    tools:context=".customer.orders.CustomerOrderDetails">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Container for Order Details -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/orderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D8D0F0"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Section with Lavender Background -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/Lavender"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order Details"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"/>
                    </LinearLayout>

                    <!-- Content Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Dynamic Order Fields with Improved Styling -->
                        <TextView
                            android:id="@+id/orderStatus"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Status: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/orderDate"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Order Date: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/customerName"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Customer Name: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/mobileNumber"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Mobile Number: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/email"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Email: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/dispatchAddress"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Dispatch Address: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/modeOfDispatch"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Mode of Dispatch: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/totalPrice"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"
                            android:text="Total Price: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/complianceStatement"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Compliance Statement: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/deviationDetails"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Deviation Details: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/discussionDetails"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Discussion Details: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/standardDeviation"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Standard Deviation: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/reviewRemarks"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Review Remarks: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/sampleCondition"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Sample Condition: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/termsAndConditions"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            android:text="Terms and Conditions: "/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E6E1F9"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/testingRequirements"
                            style="@style/OrderDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4A4A4A"
                            android:textSize="16sp"
                            android:text=""/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Back Button with Lavender Style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="@color/white"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/Lavender"
                app:layout_constraintTop_toBottomOf="@id/orderCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>