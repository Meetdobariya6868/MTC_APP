<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Single Unified Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Section with Gradient Background -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/header_gradient"
                    android:paddingVertical="28dp"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/nameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="John Doe"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05"
                        android:layout_centerHorizontal="true"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_below="@id/nameText"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/addressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123 Main Street"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:drawableStart="@drawable/ic_location"
                            android:drawablePadding="16dp"
                            android:drawableTint="@android:color/white"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="sans-serif"
                            android:alpha="0.9"/>

                        <TextView
                            android:id="@+id/phoneText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9876543210"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:drawableStart="@drawable/ic_phone"
                            android:drawablePadding="16dp"
                            android:drawableTint="@android:color/white"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="sans-serif"
                            android:alpha="0.9"/>

                        <TextView
                            android:id="@+id/emailText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="john@example.com"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="16dp"
                            android:drawableTint="@android:color/white"
                            android:gravity="center_vertical"
                            android:fontFamily="sans-serif"
                            android:alpha="0.9"/>
                    </LinearLayout>
                </RelativeLayout>

                    <TextView
                        android:id="@+id/radioSelectionsText"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Radio Selections" />

                <TextView
                    android:id="@+id/reviewRemarksText"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Review Remarks" />

                <TextView
                    android:id="@+id/selectedPointsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected Points" />

                <TextView
                    android:id="@+id/totalPriceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ttoal price" />

                <TextView
                    android:id="@+id/deviationDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deviation Detail" />

                <TextView
                    android:id="@+id/discussionDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Discussion Detail" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date" />

                <TextView
                    android:id="@+id/testSelectionsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test Selections"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Order Status Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="#F0F4FF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dispatch"
                                    android:textSize="14sp"
                                    android:textColor="#666666"
                                    android:fontFamily="sans-serif" />

                                <TextView
                                    android:id="@+id/dispatchModeText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Express"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/Lavender"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:layout_marginStart="8dp"
                            app:cardBackgroundColor="#F0F4FF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sample"
                                    android:textSize="14sp"
                                    android:textColor="#666666"
                                    android:fontFamily="sans-serif" />

                                <TextView
                                    android:id="@+id/sampleText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Yes"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/Lavender"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Segments Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selected Segments"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/segmentsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Segment A, Segment B"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/Lavender"
                            android:background="@drawable/segment_chip_background"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <!-- Review Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Review Remarks"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:boxBackgroundColor="#F5F7FF"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/remarksText"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:hint="Enter remarks here..."
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:textColorHint="#999999"
                            android:gravity="top"
                            android:padding="16dp"
                            android:fontFamily="sans-serif"
                            android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Terms and Conditions -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/termsCheckbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I agree to the Terms and Conditions"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:buttonTint="@color/Lavender"
                        android:fontFamily="sans-serif"
                        android:contentDescription="Terms and conditions agreement"
                        android:layout_marginBottom="24dp"/>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:text="Edit"
                            app:backgroundTint="@color/Lavender"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="12dp"
                            app:cornerRadius="28dp"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            app:elevation="6dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/deleteButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:text="Delete"
                            app:backgroundTint="#F0F4FF"
                            android:textColor="@color/Lavender"
                            app:cornerRadius="28dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            app:strokeColor="@color/Lavender"
                            app:strokeWidth="1dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>